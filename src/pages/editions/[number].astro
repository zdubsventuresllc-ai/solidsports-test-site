---
// EDITION page (handoff §8 /editions/003) — card hero, mono spec table,
// donation tracker, buy CTA via the shop adapter. Sold editions render sold-out.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Card from '../../components/Card.astro';
import QuoteBlock from '../../components/QuoteBlock.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import FooterTicker from '../../components/FooterTicker.astro';
import {
  editions, raisedDisplay, serialLine, nextSerial,
  UNITS_PER_EDITION, DONATION_PER_BAT, SHOPIFY,
} from '../../data/editions.js';
import { shop } from '../../lib/shop.js';

export function getStaticPaths() {
  return editions
    .filter((e) => e.handle)
    .map((e) => ({ params: { number: e.number } }));
}

const { number } = Astro.params;
const ed = editions.find((e) => e.number === number);
const product = shop.product(ed.handle);
const isLive = ed.status === 'LIVE';
const pct = Math.round((ed.pulled / UNITS_PER_EDITION) * 100);

const specs = [
  ['EDITION', `NO. ${ed.number} — SERIES 1`],
  ['RUN', `${UNITS_PER_EDITION} UNITS. NEVER REPRINTED.`],
  ['CAUSE', ed.causeFull.toUpperCase()],
  ['DONATION', `$${DONATION_PER_BAT} PER BAT — RECEIPTS ON FILE`],
  ['CARD', 'NUMBERED. SERIAL MATCHES THE BAT.'],
  ['CERTIFICATION', 'ASA / USSSA'],
  ['BUILT', 'USA — PURE SPORTS TECHNOLOGIES'],
  ['PRICE', product?.price ? `$${product.price}` : 'TBD'],
];
---
<Base title={`SOLID. — Edition ${ed.number} ${ed.cause}`}>
  <main>
    <Nav />

    {/* the ONE stadium-black section on this page */}
    <section class="ed-hero">
      <div class="ed-hero-numeral" aria-hidden="true">{ed.number}</div>
      <div class="ed-hero-inner">
        <div class="ed-hero-card">
          <Card ed={ed} size="lg" tilt={-2} />
        </div>
        <div class="ed-hero-copy">
          <div class="ed-eyebrow">EDITION {ed.number} ▸ {isLive ? 'LIVE NOW' : 'SOLD OUT'}</div>
          <h1>{ed.cause}</h1>
          <p class="ed-blurb">{ed.blurb}</p>

          <div class="ed-tracker">
            <div class="ed-tracker-row">
              <span>{serialLine(ed)} PULLED</span>
              <span>{raisedDisplay(ed)} RAISED</span>
            </div>
            <div class="ed-tracker-bar">
              <div class="ed-tracker-fill" style={`width:${pct}%;`}></div>
            </div>
            <div class="ed-tracker-note">
              ${DONATION_PER_BAT} of every pull goes to
              {ed.causeUrl
                ? <a href={ed.causeUrl} target="_blank" rel="noopener">{ed.causeFull}</a>
                : ed.causeFull}.
            </div>
          </div>

          {isLive ? (
            <a
              class="btn-pull"
              href={shop.checkoutUrl(ed.handle)}
              id="reserve"
              data-buy
              data-domain={SHOPIFY.live ? SHOPIFY.domain : null}
              data-token={SHOPIFY.live ? SHOPIFY.storefrontToken : null}
              data-variant={ed.variantId}
            >
              PULL NO. {nextSerial(ed)} → ${product.price}
            </a>
          ) : (
            <div class="ed-soldout-stamp">SOLD OUT — {UNITS_PER_EDITION}/{UNITS_PER_EDITION} PULLED</div>
          )}
        </div>
      </div>
    </section>

    <section class="ed-specs">
      <h2 class="ed-specs-heading">Stat line.</h2>
      <table>
        <tbody>
          {specs.map(([k, v]) => (
            <tr>
              <td class="spec-key">{k}</td>
              <td class="spec-val">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <QuoteBlock />
    <EmailCapture />
    <FooterTicker />
  </main>
</Base>

<script>
  // Live checkout: create a Shopify cart for this edition's variant and hand
  // off to Shopify-hosted checkout (handoff §8: checkout is never custom).
  const btn = document.querySelector('[data-buy]');
  if (btn && btn.dataset.domain && btn.dataset.variant) {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      btn.style.opacity = '0.6';
      try {
        const resp = await fetch(`https://${btn.dataset.domain}/api/2026-04/graphql.json`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Shopify-Storefront-Access-Token': btn.dataset.token,
          },
          body: JSON.stringify({
            query: `mutation cartCreate($lines: [CartLineInput!]!) {
              cartCreate(input: { lines: $lines }) {
                cart { checkoutUrl }
                userErrors { message }
              }
            }`,
            variables: { lines: [{ merchandiseId: btn.dataset.variant, quantity: 1 }] },
          }),
        });
        const { data } = await resp.json();
        const url = data?.cartCreate?.cart?.checkoutUrl;
        if (url) { window.location.href = url; return; }
        throw new Error(data?.cartCreate?.userErrors?.[0]?.message || 'cart failed');
      } catch (err) {
        console.error('checkout handoff failed', err);
        btn.style.opacity = '1';
      }
    });
  }
</script>

<style>
  .ed-hero {
    position: relative;
    background: var(--stadium-black);
    overflow: hidden;
    padding: 80px 48px;
  }

  .ed-hero-numeral {
    position: absolute;
    right: -40px;
    top: -60px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(240px, 40vw, 520px);
    color: var(--powder);
    line-height: 0.85;
    letter-spacing: -0.04em;
    opacity: 0.18;
    pointer-events: none;
  }

  .ed-hero-inner {
    position: relative;
    display: flex;
    gap: 64px;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    z-index: 2;
  }

  .ed-eyebrow {
    font-family: var(--font-kinetic);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--red);
    background: var(--cream);
    display: inline-block;
    padding: 4px 10px;
  }

  .ed-hero-copy h1 {
    font-size: clamp(48px, 7vw, 96px);
    color: var(--hero-text);
    margin-top: 16px;
  }

  .ed-blurb {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    color: var(--hero-text-2);
    max-width: 480px;
    margin-top: 14px;
  }

  .ed-tracker { margin-top: 28px; max-width: 480px; }

  .ed-tracker-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--hero-text);
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .ed-tracker-bar {
    height: 10px;
    background: rgba(245, 242, 232, 0.18);
    border: 1px solid rgba(245, 242, 232, 0.4);
  }

  .ed-tracker-fill { height: 100%; background: var(--red); }

  .ed-tracker-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--hero-text-2);
    margin-top: 8px;
    letter-spacing: 0.04em;
  }

  .ed-tracker-note a { text-decoration: underline; }

  .btn-pull {
    display: inline-block;
    margin-top: 28px;
    background: var(--red);
    color: var(--ink-on-red);
    padding: 18px 28px;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.18em;
    font-weight: 700;
    text-transform: uppercase;
  }
  .btn-pull:hover { background: var(--red-dark); }

  .ed-soldout-stamp {
    display: inline-block;
    margin-top: 28px;
    transform: rotate(-3deg);
    background: var(--gold);
    color: var(--stadium-black);
    border: 2px solid var(--stadium-black);
    padding: 12px 20px;
    font-family: var(--font-slab);
    font-size: 18px;
    letter-spacing: 0.04em;
  }

  .ed-specs {
    padding: 64px 48px;
    max-width: 900px;
    margin: 0 auto;
  }

  .ed-specs-heading {
    font-family: var(--font-slab);
    font-size: clamp(32px, 4vw, 48px);
    color: var(--navy);
    text-shadow: 2px 2px 0 var(--red);
    margin-bottom: 24px;
    text-transform: none;
  }

  .ed-specs table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
  }

  .ed-specs td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--powder-3);
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .spec-key { color: var(--navy-3); width: 180px; font-size: 11px; letter-spacing: 0.2em; }
  .spec-val { color: var(--navy); }

  @media (max-width: 900px) {
    .ed-hero { padding: 56px 20px; }
    .ed-hero-inner { flex-direction: column; gap: 40px; }
    .ed-specs { padding: 48px 20px; }
    .spec-key { width: 120px; }
  }
</style>
