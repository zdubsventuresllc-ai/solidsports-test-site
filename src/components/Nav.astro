---
import Logo from './Logo.astro';
import { totalRaisedDisplay, setProgress, liveEdition } from '../data/editions.js';

const live = liveEdition();
const { current = '' } = Astro.props;
---
<nav>
  <span class="nav-links">
    <a href="/" aria-label="Solid home"><Logo ground="light" size="16px" /></a>
    <a href="/the-set" class:list={['nav-link', { active: current === 'the-set' }]}>The Set</a>
    <a href="/#roster" class="nav-link">The Roster</a>
    <a href="/story" class:list={['nav-link', { active: current === 'story' }]}>Story</a>
  </span>
  <span class="nav-right">
    <span class="nav-ticker">{totalRaisedDisplay()} RAISED · {setProgress()}</span>
    {live && <a class="nav-cta" href={`/editions/${live.number}`}>RESERVE {live.number}</a>}
  </span>
</nav>

<style>
  nav {
    background: var(--powder-2);
    color: var(--navy);
    padding: 12px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-kinetic);
    font-size: 12px;
    letter-spacing: var(--track-stamp);
    text-transform: uppercase;
    border-bottom: 2px solid var(--red);
    position: relative;
    z-index: 10;
  }

  .nav-links, .nav-right {
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .nav-right { gap: 14px; }

  .nav-link { opacity: 0.7; }
  .nav-link:hover, .nav-link.active { opacity: 1; }

  .nav-ticker {
    color: var(--navy-2);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .nav-cta {
    background: var(--red);
    color: var(--ink-on-red);
    padding: 5px 12px;
  }
  .nav-cta:hover { background: var(--red-dark); }

  @media (max-width: 860px) {
    nav { padding: 12px 16px; font-size: 10px; flex-wrap: wrap; row-gap: 10px; }
    .nav-ticker { display: none; }
    .nav-links { gap: 12px; flex-wrap: wrap; }
    .nav-cta { white-space: nowrap; }
  }
</style>
