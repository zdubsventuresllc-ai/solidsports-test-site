---
// Email capture — mock for v1; wires to Shopify customerCreate / Klaviyo later (handoff §9.7).
---
<section class="email-capture">
  <div class="email-heading">GET THE NEXT PACK IN YOUR INBOX</div>
  <form class="email-form" data-email-capture>
    <input type="email" name="email" placeholder="email@team.com" required />
    <button type="submit">NOTIFY ME</button>
  </form>
  <div class="email-confirm" hidden>YOU'RE ON THE ROSTER. ★</div>
</section>

<script>
  document.querySelectorAll('[data-email-capture]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // mock capture — swap for Shopify customerCreate / Klaviyo when wired
      form.hidden = true;
      form.nextElementSibling.hidden = false;
    });
  });
</script>

<style>
  .email-capture {
    padding: 60px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px solid var(--red);
    gap: 24px;
    flex-wrap: wrap;
  }

  .email-heading {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--navy);
  }

  .email-form { display: flex; gap: 1px; }

  .email-form input {
    background: transparent;
    border: 2px solid var(--navy);
    padding: 14px 18px;
    color: var(--navy);
    width: 320px;
    max-width: 56vw;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .email-form input::placeholder { color: var(--navy-3); }

  .email-form button {
    background: var(--red);
    color: var(--ink-on-red);
    border: none;
    padding: 14px 24px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .email-form button:hover { background: var(--red-dark); }

  .email-confirm {
    font-family: var(--font-kinetic);
    font-size: 14px;
    letter-spacing: var(--track-stamp);
    color: var(--red);
  }

  @media (max-width: 700px) {
    .email-capture { padding: 40px 20px; }
  }
</style>
